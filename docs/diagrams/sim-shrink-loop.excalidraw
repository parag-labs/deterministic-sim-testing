    {
      "type": "text",
      "id": "text-27",
      "x": 40,
      "y": 530,
      "width": 880,
      "height": 35,
      "text": "Same seed replays byte-identically, so a failing seed is a permanent reproducer -",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-28",
      "x": 40,
      "y": 562,
      "width": 880,
      "height": 35,
      "text": "and ddmin strips its fault schedule to the one or two faults that actually matter.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
